modules = ["nodejs-20", "python-3.12", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["github:1.0.0"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/mobile && npx expo start --web --port 5000 --clear"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3000 node apps/api/src/index.js"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3003

[[ports]]
localPort = 3101
externalPort = 5000

[[ports]]
localPort = 3999
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8090
externalPort = 4200

[[ports]]
localPort = 8091
externalPort = 5173

[[ports]]
localPort = 8095
externalPort = 6000

[[ports]]
localPort = 8096
externalPort = 6800

[deployment]
deploymentTarget = "static"
run = ["bash", "-c", "PORT=5000 node apps/api/src/index.js"]
build = ["bash", "-c", "npm install && cd apps/mobile && APP_ENV=production CI=1 npx expo export --platform web"]
publicDir = "apps/mobile/dist"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
